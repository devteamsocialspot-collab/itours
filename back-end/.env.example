PORT=8080

# Postgres (always required)
POSTGRES_DB_NAME=itours
POSTGRES_DB_USERNAME=postgres
POSTGRES_DB_PASSWORD=postgres
POSTGRES_DB_HOST=localhost
POSTGRES_DB_PORT=5432
# dev: true (model.sync per model at boot). prod: false — schema changes are hand-written SQL in src/config/database.ts
POSTGRES_SYNC_ON_START=true
# lets sync() ALTER existing tables; flip on deliberately, alter can mangle columns
POSTGRES_SYNC_ALTER=false

# Auth
PASSWORD_HASH_SALT=10
JWT_TOKEN_SALT=change-me-to-a-long-random-string

# First SUPER_ADMIN, created at boot if that phone doesn't exist yet (leave empty to skip)
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_PHONE=99000000
SEED_ADMIN_PASSWORD=admin123

# Dev only: agencies, trip plans, travellers, past trips with reviews and next season's bookings.
# Seeds once, into an empty Operators table. Every demo account signs in with this password.
SEED_DEMO=true
SEED_DEMO_PASSWORD=demo1234

# Marketplace money
# the share of every booking kept by itours; the operator is paid out the rest the day after the trip ends
COMMISSION_PERCENT=5
# prices are set in USD; tögrög is shown next to them at this rate
MNT_PER_USD=3500

# Object storage for plan photo uploads (S3-compatible — DigitalOcean Spaces).
# All empty = POST /upload returns 404 and the plan editor falls back to pasting a URL.
SPACE_BUCKET_NAME=
SPACE_ENDPOINT=
SPACE_REGION=
SPACE_ACCESS_KEY=
SPACE_SECRET_KEY=
SPACE_CDN_BASE=
UPLOAD_MAX_MB=8
