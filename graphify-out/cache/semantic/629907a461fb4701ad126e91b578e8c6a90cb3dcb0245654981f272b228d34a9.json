{"nodes": [{"id": "readme_itours_mn", "label": "itours.mn Integrated Booking System", "file_type": "document", "source_file": "README.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bachelor thesis project (National University of Mongolia): booking system for Mongolian travel agencies where honesty of promises, not ad spend, ranks the marketplace."}, {"id": "readme_expectation_score", "label": "Expectation Score", "file_type": "rationale", "source_file": "README.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each plan states its pros and cons; travellers rate each promise after the trip, and how closely trips matched promises ranks plans instead of ad spend. A reworded promise starts its ratings over. Computed in plan.controller.ts."}, {"id": "readme_back_end_app", "label": "Back-end API (Express 5 + Apollo Server 5 + Sequelize 6)", "file_type": "concept", "source_file": "README.md", "source_location": "L10", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_front_end_app", "label": "Front-end Web (Next.js 15 App Router + Apollo Client 3)", "file_type": "concept", "source_file": "README.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_no_monorepo_tooling", "label": "Two Apps, One Repo, No Monorepo Tooling", "file_type": "rationale", "source_file": "README.md", "source_location": "L6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Apps are kept independent; the GraphQL schema is the only contract between them, so no shared workspace tooling is needed."}, {"id": "readme_graphql_schema_contract", "label": "GraphQL Schema as Sole FE/BE Contract", "file_type": "rationale", "source_file": "README.md", "source_location": "L13", "source_url": null, "captured_at": n